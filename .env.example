# Where eti-api lives, including the /api prefix and no trailing slash.
#
# Leave it unset and the dashboard assumes the API is on port 8000 of whatever
# host is serving it, so one build works on localhost, 192.168.0.63 and
# 10.214.94.41 without an env file per network. Set it only when the API is on
# a different host or port than the dashboard.
#
# NEXT_PUBLIC_API_URL=http://192.168.0.63:8000/api
